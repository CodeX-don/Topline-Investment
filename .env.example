# Site Configuration
# Production origin, without a trailing slash (e.g. https://toplin.com.na)
NEXT_PUBLIC_SITE_URL=
# WhatsApp number without the leading + (defaults to 264817184507)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Search Console verification (meta tag content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Reserved for a future Google Maps Embed API integration.
# The current map uses the public Google Maps embed and needs no key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email delivery (Resend). Optional: without EMAIL_API_KEY, enquiries are
# validated and logged server-side, and the API still returns success.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=
